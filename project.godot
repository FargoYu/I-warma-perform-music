[layer_names]

2d_physics/layer_1="Blocks"
2d_physics/layer_2="Warma"
2d_physics/layer_3="Giraffe"
2d_physics/layer_4="MusicBullet"
2d_physics/layer_5="Pickup"
2d_physics/layer_6="Door"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
2d/solver/solver_iterations=32
2d/solver/contact_recycle_radius=0.01
2d/solver/contact_max_separation=0.05
2d/solver/contact_max_allowed_penetration=0.01

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
